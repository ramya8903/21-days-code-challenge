print("----Online Grocery Store----")

item = input("Enter Item Name:")
price = float(input("Enter Price of Item:"))
qty = int(input("Enter Quantity:"))

total = price * qty

print("\n-----Order Bill-----")
print("Item Name:",item)
print("Price:",price)
print("Quantity:",qty)
print("Total Amount:",total)

